<?xml version="1.0" encoding="utf-8"?>
<!-- Rosenweg Messenger: Gruppen-/Kontakt-Info (wie das Gruppen-Fenster der PWA) -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/gruppe_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/gruppe_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/gruppe_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/color_primary"
            app:titleTextAppearance="@style/AppTheme.ActionBar.TitleTextStyle" />

    </org.fossify.commons.views.MyAppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/gruppe_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/gruppe_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/activity_margin">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/activity_margin">

                <ImageView
                    android:id="@+id/gruppe_logo"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/gruppe_logo_aendern"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/rw_kreis"
                    android:contentDescription="Logo ändern"
                    android:padding="9dp"
                    android:src="@drawable/ic_camera_vector"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </FrameLayout>

            <TextView
                android:id="@+id/gruppe_logo_entfernen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:padding="@dimen/small_margin"
                android:text="Eigenes Logo entfernen"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/gruppe_titel_holder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/medium_margin"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/small_margin">

                <TextView
                    android:id="@+id/gruppe_titel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/big_text_size"
                    android:textStyle="bold"
                    tools:text="Technik" />

                <ImageView
                    android:id="@+id/gruppe_titel_aendern"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="@dimen/small_margin"
                    android:contentDescription="Umbenennen"
                    android:src="@drawable/ic_edit_vector"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>

            <TextView
                android:id="@+id/gruppe_untertitel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:alpha="0.7"
                tools:text="Gruppe · 5 Mitglieder" />

            <TextView
                android:id="@+id/gruppe_fehler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:padding="@dimen/small_margin"
                android:textColor="#D32F2F"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/gruppe_mitglieder_kopf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/activity_margin"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/activity_margin"
                android:paddingEnd="@dimen/activity_margin">

                <TextView
                    android:id="@+id/gruppe_mitglieder_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Mitglieder"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/gruppe_hinzufuegen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/small_margin"
                    android:text="+ Hinzufügen"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/gruppe_mitglieder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/gruppe_medien_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/activity_margin"
                android:paddingStart="@dimen/activity_margin"
                android:paddingEnd="@dimen/activity_margin"
                android:text="Geteilte Medien"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/gruppe_medien"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/activity_margin"
                android:paddingEnd="@dimen/activity_margin" />

            <Button
                android:id="@+id/gruppe_schliessen"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/activity_margin"
                android:text="Schliessen" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
